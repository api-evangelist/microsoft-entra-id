              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Create an application registration"
        },
        {
          "info": {
            "name": "Get an application",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://graph.microsoft.com/v1.0/applications/:id",
            "params": [
              {
                "name": "id",
