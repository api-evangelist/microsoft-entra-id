                "description": "The id or userPrincipalName of the directory object"
              }
            ],
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Update an application"
        },
        {
          "info": {
            "name": "Delete an application",
            "type": "http"
          },
          "http": {
            "method": "DELETE",
            "url": "https://graph.microsoft.com/v1.0/applications/:id",
            "params": [
              {
                "name": "id",
                "value": "",
                "type": "path",
                "description": "The id or userPrincipalName of the directory object"
              }
